# Application
NODE_ENV=development
PORT=3000

# CORS: comma-separated list of allowed origins (use * only in development)
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_starter?schema=public

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-every-environment
JWT_EXPIRES_IN=15m

# Throttling (rate limiting)
THROTTLE_TTL=60000
THROTTLE_LIMIT=20

# Bootstrap admin account (used only by `npm run prisma:seed`)
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin

# Vercel Blob (optional — only required for student photo uploads;
# get a token from your Vercel project's Storage > Blob settings)
BLOB_READ_WRITE_TOKEN=
